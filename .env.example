# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================================
# AOS FOUNDATION - PRODUCTION SUPABASE & DEPLOYMENT CONFIG
# ==========================================================
# VITE_SUPABASE_URL: The REST URL of your Supabase project (from Project Settings -> API)
# Example: https://xyzcompany.supabase.co
VITE_SUPABASE_URL=""

# VITE_SUPABASE_ANON_KEY: The public anonymous API key (safe for client-side queries with RLS)
VITE_SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE_KEY: Optional server-side administrative key (NEVER expose to browser)
# Used only if executing server actions or bypassing RLS for bulk migrations
SUPABASE_SERVICE_ROLE_KEY=""

# OFFICIAL_PHONE_NUMBER: Official foundation WhatsApp contact line
VITE_FOUNDATION_PHONE="08168779732"
